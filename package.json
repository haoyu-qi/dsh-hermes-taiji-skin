{
  "name": "@local/dsh-hermes-skin",
  "version": "2.0.0",
  "description": "DeepSeek 乾坤问道：与真实推理状态联动的纸墨金主题、三档视觉深度、每日卦象与太极开场。",
  "type": "module",
  "license": "MIT",
  "author": "Qijinchun (haoyu-qi)",
  "homepage": "https://github.com/haoyu-qi/dsh-hermes-taiji-skin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoyu-qi/dsh-hermes-taiji-skin.git"
  },
  "bugs": {
    "url": "https://github.com/haoyu-qi/dsh-hermes-taiji-skin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skin",
    "theme",
    "bagua",
    "calligraphy"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "assets/ink-landscape.webp",
    "assets/GENERATION.md",
    "src/",
    "scripts/build.mjs",
    "V2.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check client.js && node --check index.js"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
