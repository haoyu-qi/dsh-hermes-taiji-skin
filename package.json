{
  "name": "@local/dsh-hermes-skin",
  "version": "3.0.0",
  "description": "深度求索 · 乾坤问道 V3：在 V2 宣纸墨金皮肤（思考氛围/每日占卜/四段开机）之上内嵌紫微斗数开源排盘引擎——模型名旁的「紫微推演」模式与入盘、每个对话与工作区各有一张十二宫命理盘、侧栏会话行的紫微速览入口 (DeepSeek Hermes Skin V3: the paper-and-gold ink skin plus the embedded open-source Ziwei Dou Shu chart engine — a ziwei reasoning mode beside the model label, a twelve-palace chart for every conversation and workspace, and a per-session chart entry in the sidebar)",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:engine": "node tools/build-engine.mjs",
    "test": "node tools/build.mjs && node tools/test-engine.mjs && node tools/build.mjs --check"
  },
  "dependencies": {
    "iztro": "^2.5.8",
    "lunar-javascript": "^1.7.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "type": "module",
  "license": "MIT",
  "author": "Qijinchun (haoyu-qi)",
  "homepage": "https://github.com/haoyu-qi/dsh-hermes-taiji-skin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoyu-qi/dsh-hermes-taiji-skin.git"
  },
  "bugs": {
    "url": "https://github.com/haoyu-qi/dsh-hermes-taiji-skin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skin",
    "theme",
    "bagua",
    "calligraphy",
    "divination",
    "thinking-depth"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
