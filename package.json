{
  "name": "@local/dsh-hermes-skin",
  "version": "3.1.1",
  "description": "乾坤问道 V3.1：八位传统神明加持（收下落印动效）、真实推理状态联动、108 签每日卦象与纸墨金主题，并内嵌紫微斗数开源排盘引擎——模型名旁的「紫微」徽记与推演模式、每个对话与工作区各一张十二宫命理盘。",
  "type": "module",
  "license": "MIT",
  "author": "Qijinchun (haoyu-qi)",
  "homepage": "https://github.com/haoyu-qi/dsh-hermes-taiji-skin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoyu-qi/dsh-hermes-taiji-skin.git"
  },
  "bugs": {
    "url": "https://github.com/haoyu-qi/dsh-hermes-taiji-skin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skin",
    "theme",
    "bagua",
    "calligraphy"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "assets/ink-landscape.webp",
    "assets/GENERATION.md",
    "src/",
    "scripts/build.mjs",
    "V2.md",
    "assets/deities/",
    "V3.md",
    "docs/images/",
    "design-qa.md",
    "design-qa-v2.md",
    "vendor/",
    "tools/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs && node tools/test-engine.mjs",
    "check": "node --check client.js && node --check index.js",
    "prepare:deities": "node scripts/prepare-deities.mjs",
    "build:engine": "node tools/build-engine.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "iztro": "^2.5.8",
    "lunar-javascript": "^1.7.3"
  }
}
