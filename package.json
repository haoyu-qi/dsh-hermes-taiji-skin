{
  "name": "@local/dsh-hermes-skin",
  "version": "1.3.0",
  "description": "深度求索 · 太极皮肤：五秒开机先天八卦 + 四向行书箴言、发送键与回车动画的太极、侧栏今日占卜一签、水墨星轨双主题 (DeepSeek Taiji Skin: five-second bagua boot animation, taiji send button and send burst, daily divination, and an ink-and-gold theme for the DSH Web GUI)",
  "type": "module",
  "license": "MIT",
  "author": "Qijinchun (haoyu-qi)",
  "homepage": "https://github.com/haoyu-qi/dsh-hermes-taiji-skin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoyu-qi/dsh-hermes-taiji-skin.git"
  },
  "bugs": {
    "url": "https://github.com/haoyu-qi/dsh-hermes-taiji-skin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skin",
    "theme",
    "bagua",
    "calligraphy"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
